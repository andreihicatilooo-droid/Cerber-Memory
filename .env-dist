# Ключ Google Gemini API (получить на https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Ключ шифрования (должен быть ровно 32 символа для AES-256)
CERBER_MASTER_KEY=default-master-key-32-characters

# Настройки Qdrant для работы внутри Docker-сети
QDRANT_HOST=qdrant
QDRANT_PORT=6333
PORT=8080
